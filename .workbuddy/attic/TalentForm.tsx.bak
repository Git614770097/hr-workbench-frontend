import { useState, useEffect } from "react";
import { useNavigate, useParams, Link } from "react-router-dom";
import {
  Card, Form, Input, InputNumber, Select, Button, Space, Typography, message, Spin,
} from "antd";
import { ArrowLeftOutlined } from "@ant-design/icons";
import { api } from "../api";
import type { Talent, Tag } from "../types";
import { STATUS_LABELS } from "../types";

const { TextArea } = Input;

export default function TalentForm() {
  const navigate = useNavigate();
  const { id } = useParams<{ id: string }>();
  const isEdit = !!id;
  const [form] = Form.useForm();
  const [loading, setLoading] = useState(isEdit);
  const [saving, setSaving] = useState(false);
  const [tags, setTags] = useState<Tag[]>([]);

  useEffect(() => {
    const fetchData = async () => {
      try {
        const tagRes = await api.getTags();
        setTags(tagRes);
        if (isEdit && id) {
          const t = await api.getTalent(id);
          form.setFieldsValue({
            ...t,
            skills: t.skills.join(", "),
            tag_ids: t.tags.map((tag) => tag.id),
          });
        }
      } catch (err) {
        message.error((err as Error).message);
      }
      setLoading(false);
    };
    fetchData();
  }, [id]);

  const handleSubmit = async (values: any) => {
    setSaving(true);
    try {
      const data = {
        ...values,
        years_experience: values.years_experience ?? undefined,
        skills: values.skills ? values.skills.split(",").map((s: string) => s.trim()).filter(Boolean) : [],
        tag_ids: values.tag_ids || [],
      };
      if (isEdit && id) {
        await api.updateTalent(id, data);
        message.success("修改已保存");
      } else {
        await api.createTalent(data);
        message.success("人才已创建");
      }
      navigate("/talents");
    } catch (err) {
      message.error((err as Error).message);
    }
    setSaving(false);
  };

  if (loading) return <div style={{ textAlign: "center", padding: "3rem" }}><Spin size="large" /></div>;

  return (
    <div style={{ maxWidth: 700 }}>
      <div style={{ marginBottom: 16 }}>
        <Link to="/talents"><Button type="text" icon={<ArrowLeftOutlined />}>返回</Button></Link>
        <Typography.Title level={4} style={{ display: "inline", marginLeft: 8 }}>
          {isEdit ? "编辑人才" : "新增人才"}
        </Typography.Title>
      </div>

      <Form form={form} layout="vertical" onFinish={handleSubmit}>
        <Card title="基本信息" style={{ marginBottom: 16 }}>
          <Form.Item name="name" label="姓名" rules={[{ required: true, message: "请输入姓名" }]}>
            <Input placeholder="必填" />
          </Form.Item>
          <Space.Compact style={{ width: "100%", marginBottom: 0 }}>
            <Form.Item name="phone" label="电话" style={{ width: "50%", paddingRight: 8 }}>
              <Input />
            </Form.Item>
            <Form.Item name="email" label="邮箱" style={{ width: "50%" }}>
              <Input />
            </Form.Item>
          </Space.Compact>
          <Space.Compact style={{ width: "100%", marginBottom: 0 }}>
            <Form.Item name="current_company" label="当前公司" style={{ width: "50%", paddingRight: 8 }}>
              <Input />
            </Form.Item>
            <Form.Item name="current_title" label="当前职位" style={{ width: "50%" }}>
              <Input />
            </Form.Item>
          </Space.Compact>
          <Space.Compact style={{ width: "100%", marginBottom: 0 }}>
            <Form.Item name="years_experience" label="工作年限" style={{ width: "50%", paddingRight: 8 }}>
              <InputNumber style={{ width: "100%" }} min={0} />
            </Form.Item>
            <Form.Item name="city" label="所在城市" style={{ width: "50%" }}>
              <Input />
            </Form.Item>
          </Space.Compact>
          <Form.Item name="industry" label="行业">
            <Input />
          </Form.Item>
        </Card>

        <Card title="求职意向" style={{ marginBottom: 16 }}>
          <Space.Compact style={{ width: "100%", marginBottom: 0 }}>
            <Form.Item name="expected_salary" label="期望薪资" style={{ width: "50%", paddingRight: 8 }}>
              <Input placeholder="如 30-40k" />
            </Form.Item>
            <Form.Item name="expected_city" label="期望城市" style={{ width: "50%" }}>
              <Input />
            </Form.Item>
          </Space.Compact>
          <Form.Item name="status" label="状态" initialValue="active">
            <Select options={Object.entries(STATUS_LABELS).map(([k, v]) => ({ label: v, value: k }))} />
          </Form.Item>
        </Card>

        <Card title="技能 & 标签" style={{ marginBottom: 16 }}>
          <Form.Item name="skills" label="技能（逗号分隔）">
            <Input placeholder="如 Java, Spring, MySQL, 微服务" />
          </Form.Item>
          {tags.length > 0 && (
            <Form.Item name="tag_ids" label="自定义标签">
              <Select
                mode="multiple"
                allowClear
                placeholder="选择标签"
                options={tags.map((t) => ({ label: t.name, value: t.id }))}
                tagRender={(props) => (
                  <span style={{ display: "inline-block", padding: "0 8px", fontSize: 12, borderRadius: 4, margin: 2, background: tags.find((t) => t.id === props.value)?.color + "20", color: tags.find((t) => t.id === props.value)?.color }}>
                    {props.label}
                  </span>
                )}
              />
            </Form.Item>
          )}
        </Card>

        <Card title="备注" style={{ marginBottom: 16 }}>
          <Form.Item name="notes">
            <TextArea rows={4} placeholder="补充说明…" />
          </Form.Item>
        </Card>

        <Space>
          <Button type="primary" htmlType="submit" loading={saving} size="large">
            {isEdit ? "保存修改" : "创建人才"}
          </Button>
          <Button size="large" onClick={() => navigate("/talents")}>取消</Button>
        </Space>
      </Form>
    </div>
  );
}
