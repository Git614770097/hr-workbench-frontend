{
  "name": "hr-workbench",
  "compatibility_date": "2026-09-18",
  "main": "./src/worker/index.ts",
  "vars": {
    // 阿里云短信认证·赠送签名与模板（非机密）。如与控制台不一致，请改为你账号下「赠送签名配置 / 赠送模板配置」里的实际值。
    "ALIBABA_SMS_SIGN_NAME": "恒创联众",
    "ALIBABA_SMS_TEMPLATE_CODE": "100001"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "hr-work.club",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 1 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hr-workbench",
      "database_id": "226fabb5-b0a7-4cb7-a4d2-a5cb31601d70"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "05b56c5b27bd4880a598a269211bd184"
    },
    {
      "binding": "RESUMES",
      "id": "99f59c90bd54489e9f48624f3688c90a"
    }
  ]
}
