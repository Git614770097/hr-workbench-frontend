{
  "name": "hr-workbench",
  "compatibility_date": "2026-09-18",
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "hr-work.club",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 1 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hr-workbench",
      "database_id": "226fabb5-b0a7-4cb7-a4d2-a5cb31601d70"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "99f59c90bd54489e9f48624f3688c90a"
    },
    {
      "binding": "RESUMES",
      "id": "99f59c90bd54489e9f48624f3688c90a"
    }
  ]
}
