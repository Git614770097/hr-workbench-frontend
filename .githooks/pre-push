#!/bin/sh
# 推送前护栏：lint。
#
# 见 .githooks/pre-commit 的注释——eslint 要建整个 TS program（43s），
# 放 commit 上太重，放 push 前刚好：代码离开本机之前一定过一遍。
#
# 注意：规则目前都是 warn 级（存量 398 条），所以这个 hook **不会**因为存量而失败。
# 例外是 src/worker 下的 no-floating-promises 设为 error（后端 0 命中，
# 它的作用是守住增量：以后漏 await 的 DB 写 / 审计写会当场红）。
set -e

echo "▸ eslint src"
npx eslint src
