{
  "name": "hr-talent-pool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:parser": "node scripts/test-resume-parser.mjs",
    "test:sql": "node scripts/test-sql-refactor.mjs",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --config wrangler.staging.jsonc",
    "deploy:prod": "wrangler deploy",
    "db:init": "wrangler d1 execute hr-workbench --remote --file=./schema.sql",
    "db:init:staging": "npx wrangler d1 execute hr-workbench-staging --remote --file=./schema.sql"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "antd": "^5.22.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "hono": "^4.6.0",
    "jszip": "^3.10.2",
    "quill": "^2.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "4.134.0"
  }
}
